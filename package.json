{
  "name": "inkweave",
  "version": "10.1.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:rust": "cd src-tauri && cargo check",
    "verify:offline": "tsx scripts/verify_offline_core.ts",
    "verify:community": "node scripts/verify-community.mjs",
    "test:ts": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rust": "cd wanxiang_engines && cargo test --workspace",
    "test:tauri": "cd src-tauri && cargo test --locked",
    "ci": "node scripts/ci-check.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.6",
    "@replit/codemirror-vim": "^6.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.12.0",
    "classic-level": "^3.0.0",
    "cmdk": "^1.1.1",
    "jszip": "^3.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
